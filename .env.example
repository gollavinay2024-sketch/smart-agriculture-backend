# Spring Boot Environment Variables Template
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_agriculture?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-deployment.vercel.app
SERVER_PORT=8080

# Optional Initial Administrator Provisioning (One-time bootstrap on first launch)
# ADMIN_INIT_EMAIL=admin@yourdomain.org
# ADMIN_INIT_PASSWORD=YourSecurePassword123!
# ADMIN_INIT_NAME=Primary Administrator
